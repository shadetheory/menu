#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo "==> Checking build libraries and headless Wayland tools"
packages=(build-essential curl ca-certificates pkg-config libwayland-dev
  libxkbcommon-dev libxkbcommon-x11-0 sway grim wtype python3)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=120 install -y --no-install-recommends "${missing[@]}"
fi
echo "==> System dependencies ready (${SECONDS}s)"

# There is no repository toolchain pin. Install stable once, without updating
# an already cached toolchain every time setup runs on a stale snapshot.
export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
fi
if ! rustup run stable rustc --version >/dev/null 2>&1; then
  rustup toolchain install stable --profile minimal
fi
rustup default stable
rustup component add clippy rustfmt

# Amp and supervised services use new non-interactive login shells.
profile_marker='# menu orb Rust toolchain'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# menu orb Rust toolchain
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi
EOF
fi
echo "==> Rust toolchain ready (${SECONDS}s)"

# Cargo validates its own cache against Cargo.lock; no extra cache markers.
# Limit parallelism to keep compilation within smaller orbs' memory budgets.
echo "==> Warming test and debug binaries"
time cargo test --locked --no-run --jobs 2
echo "==> Warming release binaries for installer and compositor checks"
time cargo build --locked --release --bins --jobs 2
echo "==> Orb setup finished (${SECONDS}s)"
